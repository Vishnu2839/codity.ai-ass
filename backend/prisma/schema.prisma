// Prisma schema for Distributed Job Scheduler
// Implements the full data model described in the assignment spec

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Organization: top-level grouping
// ─────────────────────────────────────────────
model Organization {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  users     User[]
  projects  Project[]
}

// ─────────────────────────────────────────────
// User: authentication entity
// ─────────────────────────────────────────────
model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt      DateTime      @default(now())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  projects       Project[]
}

// ─────────────────────────────────────────────
// Project: top-level container owned by a user
// ─────────────────────────────────────────────
model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  userId         String
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])
  queues       Queue[]

  @@index([userId])
}

// ─────────────────────────────────────────────
// Queue: job queue belonging to a project
// retryPolicyType: "fixed" | "linear" | "exponential"
// ─────────────────────────────────────────────
model Queue {
  id                    String   @id @default(uuid())
  name                  String
  priority              Int      @default(0)
  retryPolicyType       String   @default("fixed")
  retryBaseDelaySeconds Int      @default(30)
  maxRetries            Int      @default(3)
  concurrency           Int      @default(1)
  isPaused              Boolean  @default(false)
  projectId             String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobs    Job[]

  @@index([projectId])
}

// ─────────────────────────────────────────────
// Job: unit of work to be executed by the worker
// type: "immediate" | "delayed" | "scheduled" | "recurring" | "batch"
// status: "scheduled" | "queued" | "claimed" | "running" | "completed" | "failed" | "dead_letter"
// ─────────────────────────────────────────────
model Job {
  id             String    @id @default(uuid())
  type           String
  payload        String    @default("{}") // JSON stored as text (SQLite limitation)
  status         String    @default("queued")
  runAt          DateTime
  cronExpression String?   // Only for recurring jobs
  retryCount     Int       @default(0)
  maxRetries     Int       @default(3)
  batchId        String?   // Groups batch jobs together
  queueId        String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  queue      Queue       @relation(fields: [queueId], references: [id], onDelete: Cascade)
  executions Execution[]

  // Composite index on [status, runAt] — this is the worker's primary query pattern
  @@index([status, runAt])
  @@index([queueId])
  @@index([batchId])
}

// ─────────────────────────────────────────────
// Execution: audit log of every status transition
// Implements Part 5 of assignment spec (state machine logging)
// ─────────────────────────────────────────────
model Execution {
  id         String   @id @default(uuid())
  jobId      String
  fromStatus String
  toStatus   String
  message    String?
  createdAt  DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

// ─────────────────────────────────────────────
// Worker: tracks active polling instances
// ─────────────────────────────────────────────
model Worker {
  id              String   @id // Often hostname or a generated UUID from the worker
  hostname        String
  status          String   @default("active") // "active", "offline", "dead"
  startedAt       DateTime @default(now())
  lastHeartbeatAt DateTime @default(now())
}

