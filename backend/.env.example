# Backend Environment Variables
# Copy this file to .env and adjust if needed.
# All defaults below work out-of-the-box for local development.

# SQLite database file path (relative to backend/prisma/)
DATABASE_URL="file:./dev.db"

# JWT signing secret — change this in any real deployment
JWT_SECRET="local-dev-secret-change-in-production"

# JWT token expiry
JWT_EXPIRES_IN="7d"

# Express server port
PORT=3001

# CORS origin for the frontend
CORS_ORIGIN="http://localhost:5173"
