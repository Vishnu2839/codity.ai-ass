# Worker Environment Variables
# Copy this file to .env — defaults work out of the box.

# Must point to the same SQLite file as the backend
DATABASE_URL="file:../backend/prisma/dev.db"

# How often the worker polls for new jobs (milliseconds)
POLL_INTERVAL_MS=2000

# Simulated job failure rate (0.0 = never fail, 1.0 = always fail)
# 0.2 = 20% failure rate — makes retry logic demonstrably testable
FAILURE_RATE=0.2

# Minimum simulated job execution time (ms)
MIN_EXEC_TIME_MS=500

# Maximum simulated job execution time (ms)
MAX_EXEC_TIME_MS=2000
